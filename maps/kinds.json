{
  "format": 1,
  "note": "The kinds catalogue (docs/proposals/map-engine.md §3.2, §3.3): every attribute a map may set, and every kind as a preset along its dotted path. Era-generic: rulesets read attributes, never kind names. Values from docs/research/terrain-taxonomy.md §4; 'tuned' marks a value chosen for play or look, not sourced.",
  "layers": {
    "relief": "the ground's height",
    "ground": "what the surface is made of, and its state",
    "water": "a water body over the ground, with its own level",
    "veg": "the low growth or the tree stand",
    "way": "roads, tracks and paths",
    "barrier": "hedges, walls and fences, on the grid's cells",
    "built": "buildings, bridges and works",
    "zone": "overrides and names"
  },
  "categories": {
    "relief": { "layers": ["relief"] },
    "ground": { "layers": ["ground", "veg"] },
    "veg": { "layers": ["veg", "ground"] },
    "water": { "layers": ["water", "ground"] },
    "way": { "layers": ["way", "relief", "ground"] },
    "barrier": { "layers": ["barrier"] },
    "built": { "layers": ["built", "relief", "ground"] },
    "work": { "layers": ["built", "relief"] },
    "zone": { "layers": ["zone"] }
  },
  "attributes": {
    "height": { "layers": ["relief", "veg", "barrier", "built"], "type": "number", "unit": "m", "min": -100, "max": 400, "season": true, "note": "relief: a landform's rise (negative: a hollow); veg: a crop's or a canopy's top; barrier, built: the top above the ground" },
    "width": { "layers": ["relief", "water", "way"], "type": "number", "unit": "m", "min": 0.5, "max": 2000 },
    "profile": { "layers": ["relief"], "type": "enum", "values": ["round", "flat", "sharp"] },
    "steep": { "layers": ["relief"], "type": "enum", "values": ["none", "left", "right"], "note": "the steeper side, looking along the line from its first point" },
    "to": { "layers": ["relief"], "type": "number", "unit": "m", "min": -100, "max": 400, "note": "a level edit's height above the datum" },
    "edge": { "layers": ["relief"], "type": "number", "unit": "m", "min": 0, "max": 500, "note": "an edit's or a plateau's soft edge; a scarp's back slope, where its high side returns to the ground" },
    "shift": { "layers": ["relief"], "type": "object", "fields": { "x": { "type": "number", "unit": "m", "min": -50000, "max": 50000 }, "z": { "type": "number", "unit": "m", "min": -50000, "max": 50000 } }, "note": "a relief.dem piece: the offset from a map point to the point of its file it reads, m (file and map both centred, x east, z north)" },
    "depth": { "layers": ["relief", "water"], "type": "number", "unit": "m", "min": 0, "max": 30, "season": true, "ramp": ["along"], "note": "relief: a cut's or a ditch's depth; water: the depth of the channel or pond below its level (a ramp along a stream gives pools)" },
    "material": { "layers": ["ground", "built"], "type": "enum", "values": ["loam", "clay", "sand", "gravel", "rock", "peat", "stone", "brick", "timber", "wattle", "earth"] },
    "moisture": { "layers": ["ground"], "type": "number", "unit": "0..1", "min": 0, "max": 1, "season": true },
    "stones": { "layers": ["ground"], "type": "number", "unit": "0..1", "min": 0, "max": 1 },
    "wear": { "layers": ["ground"], "type": "number", "unit": "0..1", "min": 0, "max": 1 },
    "snow": { "layers": ["ground"], "type": "number", "unit": "m", "min": 0, "max": 3, "season": true },
    "growth": { "layers": ["veg"], "type": "enum", "values": ["none", "low", "stand", "tree"], "note": "which vegetation layer the kind fills; tree: free-standing trees, listed one by one, never painted into the cells" },
    "form": { "layers": ["veg"], "type": "enum", "values": ["round", "columnar", "conical"], "note": "a free-standing tree's silhouette" },
    "crown": { "layers": ["veg"], "type": "number", "unit": "m", "min": 0.5, "max": 15, "note": "a free-standing tree's crown radius" },
    "spacing": { "layers": ["veg"], "type": "number", "unit": "m", "min": 2, "max": 50, "note": "a row of trees: the distance between two" },
    "density": { "layers": ["veg"], "type": "number", "unit": "0..1", "min": 0, "max": 1, "ramp": ["edge", "along"], "season": true },
    "stage": { "layers": ["veg"], "type": "enum", "values": ["standing", "stubble", "ploughed", "fallow"], "season": true },
    "leaf": { "layers": ["veg"], "type": "enum", "values": ["broad", "needle", "mixed"] },
    "crownBase": { "layers": ["veg"], "type": "number", "unit": "m", "min": 0, "max": 40 },
    "undergrowth": { "layers": ["veg"], "type": "number", "unit": "0..1", "min": 0, "max": 1, "season": true },
    "rows": { "layers": ["veg"], "type": "object", "fields": { "dir": { "type": "number", "unit": "rad", "min": -7, "max": 7 }, "spacing": { "type": "number", "unit": "m", "min": 1, "max": 50 } } },
    "level": { "layers": ["water"], "type": "number", "unit": "m", "min": -100, "max": 400, "season": true, "note": "a pond's or lake's surface above the datum; a stream's level is the compiler's (§4)" },
    "flow": { "layers": ["water"], "type": "number", "unit": "m/s", "min": 0, "max": 5, "season": true },
    "bed": { "layers": ["water"], "type": "enum", "values": ["mud", "sand", "gravel", "stone"] },
    "banks": { "layers": ["water"], "type": "object", "fields": { "left": { "type": "enum", "values": ["plain", "cut", "bar", "reed"] }, "right": { "type": "enum", "values": ["plain", "cut", "bar", "reed"] } } },
    "ice": { "layers": ["water"], "type": "number", "unit": "m", "min": 0, "max": 2, "season": true },
    "surface": { "layers": ["way"], "type": "enum", "values": ["paved", "brick", "metalled", "earth"], "note": "paved: setts or cobbles" },
    "cut": { "layers": ["way"], "type": "number", "unit": "m", "min": 0, "max": 6, "note": "a sunken way's depth below the land" },
    "raise": { "layers": ["way"], "type": "number", "unit": "m", "min": 0, "max": 6, "note": "a causeway's height above the land" },
    "hedges": { "layers": ["way"], "type": "enum", "values": ["none", "left", "right", "both"] },
    "thickness": { "layers": ["barrier"], "type": "int", "unit": "cells", "min": 2, "max": 8, "even": true },
    "porosity": { "layers": ["barrier"], "type": "number", "unit": "0..1", "min": 0, "max": 1, "season": true },
    "crossing": { "layers": ["barrier"], "type": "enum", "values": ["open", "jump", "climb", "push", "none"] },
    "gaps": { "layers": ["barrier"], "type": "object", "less": ["width", "every"], "fields": { "every": { "type": "int", "unit": "steps", "min": 2, "max": 1000 }, "width": { "type": "int", "unit": "steps", "min": 1, "max": 100 } } },
    "wall": { "layers": ["built"], "type": "number", "unit": "m", "min": 0, "max": 30, "note": "a building's wall height" },
    "roof": { "layers": ["built"], "type": "enum", "values": ["none", "thatch", "tile", "slate"] },
    "parapet": { "layers": ["built"], "type": "number", "unit": "m", "min": 0, "max": 6 },
    "ditch": { "layers": ["built"], "type": "number", "unit": "m", "min": 0, "max": 6, "note": "a work's ditch depth, outside its parapet" },
    "facing": { "layers": ["built"], "type": "number", "unit": "rad", "min": -7, "max": 7 },
    "houses": { "layers": ["built"], "type": "int", "unit": "count", "min": 1, "max": 500 },
    "text": { "layers": ["zone"], "type": "string" },
    "lang": { "layers": ["zone"], "type": "string" }
  },
  "kinds": {
    "relief.base": { "shapes": ["none"], "refs": {}, "set": { "height": 0, "width": 400 }, "note": "the gentle ground between the landforms: seeded value noise over the whole extent, ± height at the scale of width (m); flat at the datum with no height" },
    "relief.dem": { "shapes": ["none", "area"], "refs": {}, "set": { "edge": 0 }, "note": "real relief: a piece of a dem source's heightfield (its file, its credit), placed at true scale and setting the height in its area (the whole extent with no shape), blended into the ground under it over `edge` m; `shift` moves it within the file; the map's datum takes the file's heights above sea level back to the map's frame" },
    "relief.hill": { "shapes": ["point", "circle", "ellipse"], "set": { "height": 10, "width": 120, "profile": "round" } },
    "relief.ridge": { "shapes": ["line"], "set": { "height": 15, "width": 200, "profile": "round", "steep": "none" } },
    "relief.valley": { "shapes": ["line"], "set": { "height": -8, "width": 200, "profile": "round", "steep": "none" } },
    "relief.plateau": { "shapes": ["area", "circle", "ellipse"], "set": { "height": 10, "edge": 60, "profile": "flat" } },
    "relief.scarp": { "shapes": ["line"], "set": { "height": 6, "width": 20, "steep": "left", "edge": 150 }, "note": "a step in the land along a line: the face rises over `width` to the steep side, which stays high and returns to the ground over `edge` m" },
    "relief.raise": { "shapes": ["area", "circle", "ellipse"], "edit": true, "set": { "height": 1, "edge": 10 } },
    "relief.lower": { "shapes": ["area", "circle", "ellipse"], "edit": true, "set": { "height": 1, "edge": 10 } },
    "relief.level": { "shapes": ["area", "circle", "ellipse"], "edit": true, "set": { "to": 0, "edge": 15 }, "note": "flattens the ground to `to`, blending over `edge`" },
    "relief.cut": { "shapes": ["line", "area"], "edit": true, "set": { "depth": 2, "width": 6, "edge": 2 } },
    "relief.ditch": { "shapes": ["line"], "edit": true, "set": { "depth": 1.5, "width": 4, "edge": 0.5 }, "note": "at least 2 cells wide (§3.3); its cells are marked for the ruleset's crossing rule" },

    "ground.meadow": { "shapes": ["area", "circle", "ellipse"], "priority": 10, "set": { "material": "loam", "moisture": 0.4, "stones": 0.05, "growth": "low", "height": 0.3, "density": 0.9 } },
    "ground.pasture": { "shapes": ["area", "circle", "ellipse"], "priority": 10, "set": { "material": "loam", "moisture": 0.35, "stones": 0.1, "growth": "low", "height": 0.1, "density": 0.9 } },
    "ground.field": { "shapes": ["area"], "priority": 20, "set": { "material": "loam", "moisture": 0.4, "stones": 0.05, "growth": "low", "height": 1.2, "density": 1, "stage": "standing" }, "seasons": { "autumn": { "stage": "stubble", "height": 0.15 }, "winter": { "stage": "ploughed", "height": 0 }, "spring": { "height": 0.4 } }, "note": "pre-modern cereal heights 1.2–1.8 m are unverified (terrain-taxonomy §4.1)" },
    "ground.field.wheat": { "set": { "height": 1.3 } },
    "ground.field.rye": { "set": { "height": 1.6 } },
    "ground.field.oats": { "set": { "height": 1.0 } },
    "ground.rough": { "shapes": ["area", "circle", "ellipse"], "priority": 15, "set": { "material": "loam", "moisture": 0.3, "stones": 0.5, "growth": "low", "height": 0.5, "density": 0.5 } },
    "ground.marsh": { "shapes": ["area", "circle", "ellipse"], "priority": 30, "set": { "material": "peat", "moisture": 1, "stones": 0, "growth": "low", "height": 1.5, "density": 0.7 } },
    "ground.yard": { "shapes": ["area", "circle", "ellipse"], "priority": 25, "set": { "material": "earth", "moisture": 0.3, "stones": 0.2, "wear": 0.8, "growth": "none" } },

    "veg.wood": { "shapes": ["area", "circle", "ellipse"], "priority": 40, "set": { "growth": "stand", "density": 0.6, "height": 20, "crownBase": 6, "undergrowth": 0.4, "leaf": "mixed" } },
    "veg.wood.broad": { "set": { "leaf": "broad" } },
    "veg.wood.conifer": { "set": { "leaf": "needle", "crownBase": 8, "undergrowth": 0.2 } },
    "veg.wood.mixed": { "set": { "leaf": "mixed" } },
    "veg.thicket": { "shapes": ["area", "circle", "ellipse"], "priority": 45, "set": { "growth": "stand", "density": 0.9, "height": 6, "crownBase": 0.5, "undergrowth": 0.9, "leaf": "broad" } },
    "veg.orchard": { "shapes": ["area", "circle", "ellipse"], "priority": 35, "set": { "growth": "stand", "density": 0.35, "height": 6, "crownBase": 1.8, "undergrowth": 0.1, "leaf": "broad", "rows": { "dir": 0, "spacing": 9 } } },
    "veg.reeds": { "shapes": ["area", "circle", "ellipse", "line"], "priority": 32, "set": { "growth": "low", "height": 2, "density": 0.8 } },
    "veg.scrub": { "shapes": ["area", "circle", "ellipse"], "priority": 18, "set": { "growth": "low", "height": 1.5, "density": 0.5 } },
    "veg.tree": { "shapes": ["point", "line"], "priority": 50, "set": { "growth": "tree", "form": "round", "leaf": "broad", "height": 15, "crown": 4, "crownBase": 3, "spacing": 10 }, "note": "a point: one tree; a line: a row, a tree every spacing m" },
    "veg.tree.poplar": { "set": { "form": "columnar", "height": 25, "crown": 1.5, "crownBase": 2, "spacing": 8 }, "note": "Lombardy poplar: lines roads, stands in twos and threes by farms" },
    "veg.tree.conifer": { "set": { "form": "conical", "leaf": "needle", "height": 18, "crown": 2.5, "crownBase": 2, "spacing": 6 } },
    "veg.tree.willow": { "set": { "height": 9, "crown": 4, "crownBase": 2, "spacing": 8 }, "note": "lines banks" },

    "water.stream": { "shapes": ["line"], "priority": 60, "set": { "width": 6, "depth": 0.8, "flow": 0.5, "bed": "gravel", "banks": { "left": "plain", "right": "plain" } } },
    "water.river": { "shapes": ["line"], "priority": 60, "set": { "width": 20, "depth": 2, "flow": 0.8, "bed": "sand", "banks": { "left": "plain", "right": "plain" } } },
    "water.pond": { "shapes": ["area", "circle", "ellipse"], "priority": 60, "set": { "depth": 1.5, "flow": 0, "bed": "mud" } },
    "water.lake": { "shapes": ["area", "circle", "ellipse"], "priority": 60, "set": { "depth": 4, "flow": 0, "bed": "mud" } },
    "water.ford": { "shapes": ["none"], "refs": { "on": "water:line", "near": "point" }, "priority": 65, "set": { "depth": 0.5, "width": 20, "bed": "gravel" } },

    "way.road": { "shapes": ["line"], "priority": 50, "set": { "width": 5, "surface": "earth", "hedges": "none" } },
    "way.road.highway": { "set": { "width": 9, "surface": "metalled" } },
    "way.road.lane": { "set": { "width": 5 } },
    "way.road.paved": { "set": { "width": 6, "surface": "paved" } },
    "way.road.brick": { "set": { "width": 5, "surface": "brick" } },
    "way.road.sunken": { "set": { "width": 4, "cut": 1.5, "hedges": "both" } },
    "way.track": { "shapes": ["line"], "priority": 50, "set": { "width": 3, "surface": "earth", "hedges": "none" } },
    "way.path": { "shapes": ["line"], "priority": 50, "set": { "width": 1.5, "surface": "earth", "hedges": "none" } },

    "barrier.hedge": { "shapes": ["line"], "priority": 70, "set": { "height": 1.8, "thickness": 2, "porosity": 0.2, "crossing": "push" }, "states": { "burnt": { "height": 0.5, "porosity": 0.9, "crossing": "climb" } } },
    "barrier.wall": { "shapes": ["line"], "priority": 70, "set": { "height": 1.4, "thickness": 2, "porosity": 0, "crossing": "climb" }, "states": { "breached": { "height": 0.6, "crossing": "climb" } } },
    "barrier.wall.garden": { "set": { "height": 2.5, "crossing": "none" } },
    "barrier.fence": { "shapes": ["line"], "priority": 70, "set": { "height": 1.2, "thickness": 2, "porosity": 0.85, "crossing": "climb" } },

    "built.house": { "shapes": ["area", "circle", "ellipse"], "priority": 80, "set": { "height": 7, "wall": 4, "roof": "tile", "material": "stone" }, "states": { "burnt": { "roof": "none", "height": 3, "wall": 1.5 } } },
    "built.barn": { "shapes": ["area"], "priority": 80, "set": { "height": 8, "wall": 4, "roof": "thatch", "material": "timber" }, "states": { "burnt": { "roof": "none", "height": 2, "wall": 1 } } },
    "built.church": { "shapes": ["area"], "priority": 80, "set": { "height": 14, "wall": 8, "roof": "slate", "material": "stone" } },
    "built.farm": { "shapes": ["area"], "priority": 75, "set": { "material": "stone", "wear": 0.6 }, "note": "a walled yard; its buildings and walls are their own features until street-village and farm generators (M3)" },
    "built.village": { "shapes": ["area", "none"], "refs": { "along": "way:line" }, "priority": 24, "set": { "houses": 12, "wear": 0.5 } },
    "built.bridge": { "shapes": ["none"], "refs": { "carries": "way:line", "crosses": "water:line", "near": "point" }, "optional": ["near"], "priority": 90, "set": { "material": "stone" } },

    "work.redoubt": { "shapes": ["area"], "priority": 85, "set": { "parapet": 1.8, "ditch": 1.5, "material": "earth" } },
    "work.fleche": { "shapes": ["line"], "priority": 85, "set": { "parapet": 1.4, "ditch": 1.2, "material": "earth" } },

    "zone.nogo": { "shapes": ["area", "circle", "ellipse"], "priority": 100, "set": {} },
    "zone.go": { "shapes": ["area", "circle", "ellipse"], "priority": 100, "set": {} },
    "zone.label": { "shapes": ["point", "line"], "priority": 0, "set": { "text": "", "lang": "en" } }
  }
}
