assets/grass-brushes/
assets/**/*.blend
assets/**/*.blend1

# Build / tooling output (for later game code)
# the map windows' look data: built, not committed (tools/build-look-data.ts; Vitest builds a missing one: test/look-data-setup.ts)
data/*-*.lookdata
!data/painted-world.lookdata
data/*.part
node_modules
dist/
coverage/
*.log

# Third-party reference frames: kept locally, never committed (their .source.txt is)
design/refs/staff-map-epic-history-waterloo.png

# Local renders and scratch
renders/
*.draft.png
scratch/
*.mp4

# golden selftest copies (tools/golden.mjs), removed after each run
prototypes/.golden-selftest-*

# The figure pipeline (tools/unitpipe/paths.py): Tripo sources (listed by hash in tools/unitpipe/sources.json),
# work files, renders and published figures
assets/tripo/
output/
__pycache__/

# Scans to trace from (decision 0069): kept locally unless their source says public domain
maps/scans/
