{
  "name": "rts",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev": "vite --open /app/",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write . --log-level warn && (eslint --fix .; s=$?; prettier --write . --log-level warn && exit $s)",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "build:data": "node tools/build-look-data.ts && node tools/build-sim-data.ts",
    "check:data": "node tools/build-look-data.ts --check && node tools/build-sim-data.ts --check",
    "check:docs": "node tools/check-docs.mjs",
    "test": "npm run lint && npm run format:check && npm run typecheck && vitest run",
    "coverage": "COVERAGE=1 vitest run --coverage",
    "check:app": "npm run build && node tools/app-check.mjs",
    "calibrate:fire": "node tools/calibrate-fire.ts"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@babylonjs/core": "9.29.0"
  }
}
